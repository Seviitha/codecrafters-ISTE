# Server
PORT=5000
NODE_ENV=development

# Database
MONGO_URI=mongodb://127.0.0.1:27017/urbaneye

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Duplicate detection radius, in meters
DUPLICATE_RADIUS_METERS=500

# Frontend origin allowed to call this API (comma-separated for multiple)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5500
